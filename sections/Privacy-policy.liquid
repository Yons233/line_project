{% stylesheet %}
/* ── Hero ── */
.line-privacy-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: center;
  overflow: hidden;
  isolation: isolate;
}
.line-privacy-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.line-privacy-hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 75% center;
}
.line-privacy-hero__text {
  position: relative;
  z-index: 1;
  max-width: 460px;
  padding-left: var(--container-pad);
  padding-block: var(--space-16);
}
.line-privacy-hero__eyebrow {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-privacy-hero__title {
  margin-top: var(--space-3);
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(var(--text-3xl), 3.6vw, var(--text-4xl));
  line-height: 1.12;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.line-privacy-hero__title-highlight {
  background: var(--gradient-champagne);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.line-privacy-hero__subtitle {
  margin-top: var(--space-4);
  max-width: 440px;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-privacy-hero__updated {
  margin-top: var(--space-8);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  color: rgba(42,36,30,0.75);
}
.line-privacy-hero__updated svg { width: 14px; height: 14px; flex-shrink: 0; }

/* ── Cuerpo: TOC + contenido de la política ── */
.line-privacy-body {
  padding-block: var(--space-10) var(--space-16);
  background: var(--white);
}
.line-privacy-body__inner {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: var(--space-16);
  align-items: start;
  max-width: 1400px;
  margin-inline: auto;
  padding-left: var(--space-4);
  padding-right: var(--container-pad);
}

.line-privacy-toc {
  position: sticky;
  top: calc(var(--header-h) + var(--space-6));
  background: rgba(var(--pastel-nav-rgb), 0.32);
  border-radius: 24px;
  padding: var(--space-8) var(--space-6) var(--space-6);
}
.line-privacy-toc__label {
  padding-left: calc(var(--space-4) + 2px);
  margin-bottom: var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-privacy-toc__list {
  margin-top: var(--space-4);
  list-style: none;
  display: flex;
  flex-direction: column;
}
.line-privacy-toc__link {
  position: relative;
  display: block;
  padding: var(--space-2) 0 var(--space-2) var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--ink-soft);
  transition: color var(--duration-fast);
}
.line-privacy-toc__link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2px;
  height: 16px;
  border-radius: var(--radius-full);
  background: transparent;
  transition: background var(--duration-fast);
}
.line-privacy-toc__link:hover { color: var(--ink); }
.line-privacy-toc__link.is-active {
  color: var(--champagne-1);
  font-weight: 600;
}
.line-privacy-toc__link.is-active::before {
  background: var(--champagne-1);
}

.line-privacy-list {
  display: flex;
  flex-direction: column;
}
.line-privacy-item {
  padding-block: var(--space-8);
  border-bottom: 1px solid rgba(42,36,30,0.10);
  scroll-margin-top: calc(var(--header-h) + var(--space-4));
}
.line-privacy-item:first-child { padding-top: 0; }
.line-privacy-item:last-child { border-bottom: none; padding-bottom: 0; }
.line-privacy-item__eyebrow {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-privacy-item__title {
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--text-lg);
  color: var(--ink);
}
.line-privacy-item__body {
  margin-top: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-privacy-item__body p + p { margin-top: var(--space-2); }

/* ── Fondo blanco de la página, solo en Privacy Policy ── */
body.template-page-privacy-policy {
  background-color: #ffffff;
}

/* ── CTA de cierre ── */
.line-privacy-cta {
  margin-inline: auto;
  max-width: 1560px;
  padding-inline: var(--container-pad);
  padding-block: var(--space-6) var(--space-8);
}
.line-privacy-cta__card {
  position: relative;
  height: 140px;
  border-radius: 28px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: var(--cream-0);
  isolation: isolate;
}
.line-privacy-cta__bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 32%;
  z-index: 0;
}
.line-privacy-cta__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 100% center;
  -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 12%);
  mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 12%);
}
.line-privacy-cta__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  width: 100%;
  padding: var(--space-6) var(--space-8);
  padding-right: 34%;
}
.line-privacy-cta__text { max-width: 480px; }
.line-privacy-cta__title {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(var(--text-xl), 1.8vw, var(--text-2xl));
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.line-privacy-cta__subtitle {
  margin-top: var(--space-1);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.5;
  color: var(--ink-soft);
  white-space: nowrap;
}
.line-privacy-cta__button {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--white);
  background: #3a3a3a;
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 8px 20px rgba(0,0,0,0.22);
  transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo);
}
.line-privacy-cta__button::before {
  content: '';
  position: absolute;
  z-index: 0;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.3) 50%, transparent 100%);
  transform: skewX(-20deg);
  transition: left 0.65s var(--ease-out-expo);
  pointer-events: none;
}
.line-privacy-cta__button:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 34px rgba(42,36,30,0.36), inset 0 1px 0 rgba(255,255,255,0.16);
}
.line-privacy-cta__button:hover::before { left: 120%; }
.line-privacy-cta__button-label { position: relative; z-index: 1; }
.line-privacy-cta__button svg {
  position: relative;
  z-index: 1;
  width: 16px;
  height: 16px;
  transition: transform 0.3s var(--ease-out-expo);
}
.line-privacy-cta__button:hover svg { transform: translateX(4px); }

/* ── Responsive ── */
@media (max-width: 700px) {
  .line-privacy-hero { min-height: 360px; }
  .line-privacy-hero__text { max-width: 100%; padding-right: var(--container-pad); }
}
@media (max-width: 1000px) {
  .line-privacy-body__inner { grid-template-columns: 1fr; gap: var(--space-10); }
  .line-privacy-toc { position: static; }
  .line-privacy-toc__list { flex-direction: row; flex-wrap: wrap; gap: var(--space-2); }
  .line-privacy-toc__link { padding: var(--space-2) var(--space-3); }
  .line-privacy-toc__link::before { display: none; }
}
@media (max-width: 640px) {
  .line-privacy-cta__card { flex-direction: column; align-items: stretch; height: auto; }
  .line-privacy-cta__bg { position: relative; width: 100%; height: 160px; }
  .line-privacy-cta__content {
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
    padding-right: var(--space-6);
  }
  .line-privacy-cta__text { max-width: 100%; }
  .line-privacy-cta__subtitle { white-space: normal; }
  .line-privacy-cta__button { margin-top: var(--space-4); }
}
{% endstylesheet %}

<section class="line-privacy-hero" id="line-privacy-hero-{{ section.id }}">
    <div class="line-privacy-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="line-privacy-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="line-privacy-hero__title">
        {{ section.settings.title_prefix }}
        {%- if section.settings.title_highlight != blank -%}
          <span class="line-privacy-hero__title-highlight">{{ section.settings.title_highlight }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="line-privacy-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.last_updated != blank -%}
        <p class="line-privacy-hero__updated">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span>{{ section.settings.last_updated }}</span>
        </p>
      {%- endif -%}
    </div>
    <div class="line-privacy-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            alt: section.settings.title_prefix,
            widths: '600,900,1200'
        }}
      {%- else -%}
        <img
          src="{{ section.settings.hero_image_fallback | default: 'AvisoLegal.png' | asset_url }}"
          alt="{{ section.settings.title_prefix }}"
          loading="eager"
          width="3868"
          height="1059"
        >
      {%- endif -%}
    </div>
</section>

<section class="line-privacy-body" id="line-privacy-body-{{ section.id }}" aria-label="{{ section.settings.toc_label }}">
  <div class="line-privacy-body__inner">

    {%- assign privacy_blocks = section.blocks | where: 'type', 'privacy_item' -%}
    {%- if privacy_blocks.size > 0 -%}
      <div class="line-privacy-toc">
        <nav aria-label="{{ section.settings.toc_label }}">
          {%- if section.settings.toc_label != blank -%}
            <p class="line-privacy-toc__label">{{ section.settings.toc_label }}</p>
          {%- endif -%}
          <ul class="line-privacy-toc__list" role="list">
            {%- for block in privacy_blocks -%}
              {%- assign item_number = forloop.index | prepend: '00' | slice: -2, 2 -%}
              <li>
                <a href="#privacy-item-{{ block.id }}" class="line-privacy-toc__link" data-privacy-toc-link data-target="privacy-item-{{ block.id }}">
                  {{ item_number }} {{ block.settings.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <div class="line-privacy-list">
        {%- for block in privacy_blocks -%}
          {%- assign item_number = forloop.index | prepend: '00' | slice: -2, 2 -%}
          <div class="line-privacy-item" id="privacy-item-{{ block.id }}" {{ block.shopify_attributes }}>
            <p class="line-privacy-item__eyebrow">Section {{ item_number }}</p>
            {%- if block.settings.title != blank -%}
              <h2 class="line-privacy-item__title">{{ block.settings.title }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="line-privacy-item__body">
                {%- assign body_paragraphs = block.settings.body | split: "

" -%}
                {%- for paragraph in body_paragraphs -%}
                  {%- assign paragraph_trimmed = paragraph | strip -%}
                  {%- if paragraph_trimmed != blank -%}
                    <p>{{ paragraph_trimmed | newline_to_br }}</p>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<div class="line-privacy-cta">
  <div class="line-privacy-cta__card">
    <div class="line-privacy-cta__bg">
      <img
        src="{{ section.settings.contact_bg_fallback | default: 'AvisoLegalContact.png' | asset_url }}"
        alt="{{ section.settings.contact_title }}"
        loading="lazy"
        width="7680"
        height="776"
      >
    </div>
    <div class="line-privacy-cta__content">
      <div class="line-privacy-cta__text">
        {%- if section.settings.contact_title != blank -%}
          <h2 class="line-privacy-cta__title">{{ section.settings.contact_title }}</h2>
        {%- endif -%}
        {%- if section.settings.contact_subtitle != blank -%}
          <p class="line-privacy-cta__subtitle">{{ section.settings.contact_subtitle }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.contact_button_label != blank -%}
        <a href="{{ section.settings.contact_button_url | default: '/pages/contacto' }}" class="btn line-privacy-cta__button">
          <span class="line-privacy-cta__button-label">{{ section.settings.contact_button_label }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function () {
  var links = document.querySelectorAll('[data-privacy-toc-link]');
  if (!links.length || !('IntersectionObserver' in window)) return;

  var items = [];
  links.forEach(function (link) {
    var target = document.getElementById(link.getAttribute('data-target'));
    if (target) items.push({ link: link, target: target });
  });
  if (!items.length) return;

  function setActive(id) {
    items.forEach(function (item) {
      item.link.classList.toggle('is-active', item.target.id === id);
    });
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { rootMargin: '-30% 0px -60% 0px' });

  items.forEach(function (item) { observer.observe(item.target); });
  setActive(items[0].target.id);
})();
</script>


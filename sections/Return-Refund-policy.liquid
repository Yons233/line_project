{% stylesheet %}
/* ── Hero ── */
.line-return-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: center;
  overflow: hidden;
  isolation: isolate;
}
.line-return-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.line-return-hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 75% center;
}
.line-return-hero__text {
  position: relative;
  z-index: 1;
  max-width: 460px;
  padding-left: var(--container-pad);
  padding-block: var(--space-16);
}
.line-return-hero__eyebrow {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-return-hero__title {
  margin-top: var(--space-3);
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(var(--text-3xl), 3.6vw, var(--text-4xl));
  line-height: 1.12;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.line-return-hero__title-highlight {
  background: var(--gradient-champagne);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.line-return-hero__subtitle {
  margin-top: var(--space-4);
  max-width: 440px;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-return-hero__updated {
  margin-top: var(--space-8);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  color: rgba(42,36,30,0.75);
}
.line-return-hero__updated svg { width: 14px; height: 14px; flex-shrink: 0; }

/* ── Cuerpo: TOC + contenido de la política ── */
.line-return-body {
  padding-block: var(--space-10) var(--space-16);
  background: var(--white);
}
.line-return-body__inner {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: var(--space-16);
  align-items: start;
  max-width: 1400px;
  margin-inline: auto;
  padding-left: var(--space-4);
  padding-right: var(--container-pad);
}

.line-return-toc {
  position: sticky;
  top: calc(var(--header-h) + var(--space-6));
  background: rgba(var(--pastel-nav-rgb), 0.32);
  border-radius: 24px;
  padding: var(--space-8) var(--space-6) var(--space-6);
}
.line-return-toc__label {
  padding-left: calc(var(--space-4) + 2px);
  margin-bottom: var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-return-toc__list {
  margin-top: var(--space-4);
  list-style: none;
  display: flex;
  flex-direction: column;
}
.line-return-toc__link {
  position: relative;
  display: block;
  padding: var(--space-2) 0 var(--space-2) var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--ink-soft);
  transition: color var(--duration-fast);
}
.line-return-toc__link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2px;
  height: 16px;
  border-radius: var(--radius-full);
  background: transparent;
  transition: background var(--duration-fast);
}
.line-return-toc__link:hover { color: var(--ink); }
.line-return-toc__link.is-active {
  color: var(--champagne-1);
  font-weight: 600;
}
.line-return-toc__link.is-active::before {
  background: var(--champagne-1);
}

.line-return-list {
  display: flex;
  flex-direction: column;
}
.line-return-item {
  padding-block: var(--space-8);
  border-bottom: 1px solid rgba(42,36,30,0.10);
  scroll-margin-top: calc(var(--header-h) + var(--space-4));
}
.line-return-item:first-child { padding-top: 0; }
.line-return-item:last-child { border-bottom: none; padding-bottom: 0; }
.line-return-item__eyebrow {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--text-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-return-item__title {
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--text-lg);
  color: var(--ink);
}
.line-return-item__body {
  margin-top: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-return-item__body p + p { margin-top: var(--space-2); }
.line-return-callout {
  display: block;
  max-width: 640px;
  box-sizing: border-box;
  padding: var(--space-4) var(--space-6);
  padding-left: calc(var(--space-6) + var(--space-1));
  background: rgba(42,36,30,0.035);
  border-left: 4px solid var(--champagne-1);
  border-radius: 0 6px 6px 0;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-return-intro-note { margin-bottom: var(--space-8); }
.line-return-item__body-callout {
  display: block;
  max-width: 640px;
  box-sizing: border-box;
  padding: var(--space-4) var(--space-6);
  background: rgba(42,36,30,0.035);
  border-radius: 6px;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}

/* ── Fondo blanco de la página, solo en Return & Refund Policy ── */
body.template-page-return-refund-policy {
  background-color: #ffffff;
}

/* ── CTA de cierre ── */
.line-return-cta {
  margin-inline: auto;
  max-width: 1560px;
  padding-inline: var(--container-pad);
  padding-block: var(--space-6) var(--space-8);
}
.line-return-cta__card {
  position: relative;
  height: 140px;
  border-radius: 28px;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: var(--cream-0);
  isolation: isolate;
}
.line-return-cta__bg {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 32%;
  z-index: 0;
}
.line-return-cta__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 100% center;
  -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 12%);
  mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 12%);
}
.line-return-cta__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  width: 100%;
  padding: var(--space-6) var(--space-8);
  padding-right: 34%;
}
.line-return-cta__text { max-width: 480px; }
.line-return-cta__title {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(var(--text-xl), 1.8vw, var(--text-2xl));
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.line-return-cta__subtitle {
  margin-top: var(--space-1);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.5;
  color: var(--ink-soft);
  white-space: nowrap;
}
.line-return-cta__button {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-6);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--white);
  background: #3a3a3a;
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 8px 20px rgba(0,0,0,0.22);
  transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo);
}
.line-return-cta__button::before {
  content: '';
  position: absolute;
  z-index: 0;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.3) 50%, transparent 100%);
  transform: skewX(-20deg);
  transition: left 0.65s var(--ease-out-expo);
  pointer-events: none;
}
.line-return-cta__button:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 34px rgba(42,36,30,0.36), inset 0 1px 0 rgba(255,255,255,0.16);
}
.line-return-cta__button:hover::before { left: 120%; }
.line-return-cta__button-label { position: relative; z-index: 1; }
.line-return-cta__button svg {
  position: relative;
  z-index: 1;
  width: 16px;
  height: 16px;
  transition: transform 0.3s var(--ease-out-expo);
}
.line-return-cta__button:hover svg { transform: translateX(4px); }

/* ── Responsive ── */
@media (max-width: 700px) {
  .line-return-hero { min-height: 360px; }
  .line-return-hero__text { max-width: 100%; padding-right: var(--container-pad); }
}
@media (max-width: 1000px) {
  .line-return-body__inner { grid-template-columns: 1fr; gap: var(--space-10); }
  .line-return-toc { position: static; }
  .line-return-toc__list { flex-direction: row; flex-wrap: wrap; gap: var(--space-2); }
  .line-return-toc__link { padding: var(--space-2) var(--space-3); }
  .line-return-toc__link::before { display: none; }
}
@media (max-width: 640px) {
  .line-return-cta__card { flex-direction: column; align-items: stretch; height: auto; }
  .line-return-cta__bg { position: relative; width: 100%; height: 160px; }
  .line-return-cta__content {
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
    padding-right: var(--space-6);
  }
  .line-return-cta__text { max-width: 100%; }
  .line-return-cta__subtitle { white-space: normal; }
  .line-return-cta__button { margin-top: var(--space-4); }
}
{% endstylesheet %}

<section class="line-return-hero" id="line-return-hero-{{ section.id }}">
    <div class="line-return-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="line-return-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="line-return-hero__title">
        {{ section.settings.title_prefix }}
        {%- if section.settings.title_highlight != blank -%}
          <span class="line-return-hero__title-highlight">{{ section.settings.title_highlight }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="line-return-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.last_updated != blank -%}
        <p class="line-return-hero__updated">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span>{{ section.settings.last_updated }}</span>
        </p>
      {%- endif -%}
    </div>
    <div class="line-return-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            alt: section.settings.title_prefix,
            widths: '600,900,1200'
        }}
      {%- else -%}
        <img
          src="{{ section.settings.hero_image_fallback | default: 'AvisoLegal.png' | asset_url }}"
          alt="{{ section.settings.title_prefix }}"
          loading="eager"
          width="3868"
          height="1059"
        >
      {%- endif -%}
    </div>
</section>

<section class="line-return-body" id="line-return-body-{{ section.id }}" aria-label="{{ section.settings.toc_label }}">
  <div class="line-return-body__inner">

    {%- assign return_blocks = section.blocks | where: 'type', 'return_item' -%}
    {%- if return_blocks.size > 0 -%}
      <div class="line-return-toc">
        <nav aria-label="{{ section.settings.toc_label }}">
          {%- if section.settings.toc_label != blank -%}
            <p class="line-return-toc__label">{{ section.settings.toc_label }}</p>
          {%- endif -%}
          <ul class="line-return-toc__list" role="list">
            {%- for block in return_blocks -%}
              {%- assign item_number = forloop.index | prepend: '00' | slice: -2, 2 -%}
              <li>
                <a href="#return-item-{{ block.id }}" class="line-return-toc__link" data-return-toc-link data-target="return-item-{{ block.id }}">
                  {{ item_number }} {{ block.settings.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <div class="line-return-list">
        {%- if section.settings.intro_note != blank -%}
          <div class="line-return-intro-note">
            <p class="line-return-callout">{{ section.settings.intro_note }}</p>
          </div>
        {%- endif -%}
        {%- for block in return_blocks -%}
          {%- assign item_number = forloop.index | prepend: '00' | slice: -2, 2 -%}
          <div class="line-return-item" id="return-item-{{ block.id }}" {{ block.shopify_attributes }}>
            <p class="line-return-item__eyebrow">Section {{ item_number }}</p>
            {%- if block.settings.title != blank -%}
              <h2 class="line-return-item__title">{{ block.settings.title }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="line-return-item__body">
                {%- assign body_paragraphs = block.settings.body | split: "

" -%}
                {%- for paragraph in body_paragraphs -%}
                  {%- assign paragraph_trimmed = paragraph | strip -%}
                  {%- if paragraph_trimmed != blank -%}
                    {%- if paragraph_trimmed contains '<!--callout-->' -%}
                      {%- assign paragraph_clean = paragraph_trimmed | remove: '<!--callout-->' -%}
                      <p class="line-return-item__body-callout">{{ paragraph_clean | newline_to_br }}</p>
                    {%- else -%}
                      <p>{{ paragraph_trimmed | newline_to_br }}</p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<div class="line-return-cta">
  <div class="line-return-cta__card">
    <div class="line-return-cta__bg">
      <img
        src="{{ section.settings.contact_bg_fallback | default: 'AvisoLegalContact.png' | asset_url }}"
        alt="{{ section.settings.contact_title }}"
        loading="lazy"
        width="7680"
        height="776"
      >
    </div>
    <div class="line-return-cta__content">
      <div class="line-return-cta__text">
        {%- if section.settings.contact_title != blank -%}
          <h2 class="line-return-cta__title">{{ section.settings.contact_title }}</h2>
        {%- endif -%}
        {%- if section.settings.contact_subtitle != blank -%}
          <p class="line-return-cta__subtitle">{{ section.settings.contact_subtitle }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.contact_button_label != blank -%}
        <a href="{{ section.settings.contact_button_url | default: '/pages/contacto' }}" class="btn line-return-cta__button">
          <span class="line-return-cta__button-label">{{ section.settings.contact_button_label }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function () {
  var links = document.querySelectorAll('[data-return-toc-link]');
  if (!links.length || !('IntersectionObserver' in window)) return;

  var items = [];
  links.forEach(function (link) {
    var target = document.getElementById(link.getAttribute('data-target'));
    if (target) items.push({ link: link, target: target });
  });
  if (!items.length) return;

  function setActive(id) {
    items.forEach(function (item) {
      item.link.classList.toggle('is-active', item.target.id === id);
    });
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { rootMargin: '-30% 0px -60% 0px' });

  items.forEach(function (item) { observer.observe(item.target); });
  setActive(items[0].target.id);
})();
</script>

{% schema %}
{
  "name": "Return & Refund Policy",
  "tag": "section",
  "class": "section-return-refund-policy",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Fair solutions, whenever you need them",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "default": "Return & Refund Policy",
      "label": "Title — text"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title — highlighted word"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "default": "At LINE, your satisfaction and peace of mind are our top priorities. This section outlines the guidelines, timeframes, and procedures for managing returns, exchanges, and refunds, ensuring a streamlined, transparent, and secure process in the event that your item does not meet your expectations.",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "last_updated",
      "default": "Last updated: June 2026",
      "label": "Last updated text"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_fallback",
      "default": "AvisoLegal.png",
      "label": "Hero image fallback (file in assets/)"
    },
    {
      "type": "header",
      "content": "Intro note"
    },
    {
      "type": "textarea",
      "id": "intro_note",
      "default": "Our policy lasts <strong>14 days</strong>. If 14 days have passed since your purchase, unfortunately we cannot offer you a refund or an exchange.",
      "label": "Highlighted note above the numbered sections"
    },
    {
      "type": "header",
      "content": "Table of contents"
    },
    {
      "type": "text",
      "id": "toc_label",
      "default": "In this page",
      "label": "Sidebar label"
    },
    {
      "type": "header",
      "content": "Closing CTA"
    },
    {
      "type": "text",
      "id": "contact_title",
      "default": "We're here for you.",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "contact_subtitle",
      "default": "If you have any questions, our team will be happy to help.",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "default": "Contact support",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "contact_button_url",
      "label": "Button link (leave empty to go to Contact)"
    },
    {
      "type": "text",
      "id": "contact_bg_fallback",
      "default": "AvisoLegalContact.png",
      "label": "Background image fallback (file in assets/)"
    }
  ],
  "blocks": [
    {
      "type": "return_item",
      "name": "Return section",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "package",
          "options": [
            { "value": "briefcase",     "label": "Briefcase" },
            { "value": "monitor",       "label": "Monitor" },
            { "value": "file-check",    "label": "File check" },
            { "value": "award",         "label": "Award" },
            { "value": "package",       "label": "Package" },
            { "value": "shield",        "label": "Shield" },
            { "value": "external-link", "label": "External link" },
            { "value": "lock",          "label": "Lock" },
            { "value": "edit",          "label": "Edit" },
            { "value": "scale",         "label": "Scale" },
            { "value": "headset",       "label": "Headset" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "default": "Section title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "default": "Section content.",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Return & Refund Policy",
      "blocks": [
        { "type": "return_item", "settings": { "icon": "package",       "title": "Eligibility Conditions", "body": "To be eligible for a return, your item must be unused and in the same condition that you received it. It must also be in its original packaging. To complete your return, we require a receipt or proof of purchase.\n\n<!--callout-->Please <strong>do not send your purchase back to the manufacturer</strong>. Please submit your return request only to the email address provided in the Shipping section." } },
        { "type": "return_item", "settings": { "icon": "shield",        "title": "Non-Returnable Items", "body": "Several types of goods are exempt from being returned:\n\nPerishable goods (food, flowers, newspapers, or magazines). Intimate or sanitary goods. Hazardous materials, or flammable liquids or gases. Gift cards. Downloadable software products. Some health and personal care items." } },

{% stylesheet %}
/* ── Hero ── */
.line-contactus-hero {
  position: relative;
  min-height: 680px;
  display: flex;
  align-items: center;
  overflow: visible;
  background-color: #f0ece9;
  background-size: cover;
  background-position: right center;
  background-repeat: no-repeat;
}
.line-contactus-hero__text {
  position: relative;
  z-index: 1;
  max-width: 420px;
  padding-left: var(--container-pad);
  padding-right: var(--space-8);
  padding-top: calc(var(--header-h) + var(--space-10));
  padding-bottom: var(--space-20);
}
.line-contactus-hero__eyebrow {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champagne-1);
}
.line-contactus-hero__title {
  margin-top: var(--space-3);
  font-family: var(--font-serif);
  font-weight: 500;
  text-transform: uppercase;
  font-size: clamp(var(--text-3xl), 3.6vw, var(--text-4xl));
  line-height: 1.12;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.line-contactus-hero__title-highlight {
  background: var(--gradient-champagne);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.line-contactus-hero__subtitle {
  margin-top: var(--space-4);
  max-width: 440px;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--ink-soft);
  text-align: justify;
}
.line-contactus-hero__updated {
  margin-top: var(--space-8);
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  color: rgba(42,36,30,0.75);
}
.line-contactus-hero__updated svg { width: 14px; height: 14px; flex-shrink: 0; }

/* ── Tarjetas de contacto rápido ── */
.line-contactus-features {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -180px;
  z-index: 2;
}
.line-contactus-features__inner {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: var(--space-6);
}
.line-contactus-features__inner::before {
  content: '';
  position: absolute;
  z-index: -1;
  inset: 0 var(--space-6);
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(42,36,30,0.14);
}
.line-contactus-features__card {
  padding: var(--space-8) var(--space-6);
  background: var(--white);
  border-radius: 0;
  border-right: 1px solid rgba(42,36,30,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.line-contactus-features__card:first-child {
  border-top-left-radius: 20px;
  border-bottom-left-radius: 20px;
}
.line-contactus-features__card:last-child {
  border-top-right-radius: 20px;
  border-bottom-right-radius: 20px;
  border-right: none;
}
.line-contactus-features__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 26%, #ffffff 0%, rgba(255,255,255,0.9) 45%, rgba(231,211,179,0.4) 85%);
  border: 1px solid rgba(255,255,255,0.85);
  box-shadow: 0 3px 8px rgba(42,36,30,0.10);
  color: var(--champagne-1);
}
.line-contactus-features__icon svg { width: 30px; height: 30px; }
.line-contactus-features__title {
  margin-top: var(--space-4);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--text-base);
  color: var(--ink);
}
.line-contactus-features__desc {
  margin-top: var(--space-2);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.6;
  color: var(--ink-soft);
}

/* ── Fondo blanco de la página, solo en Contact Us ── */
body.template-page-contact-us {
  background-color: #ffffff;
}

/* ── Send us a message ── */
.line-contactus-msg {
  padding-block: 220px var(--space-16);
  background: var(--white);
}
.line-contactus-msg__card {
  position: relative;
  max-width: 560px;
  margin-inline: auto;
  padding: var(--space-10) var(--space-8);
  background: linear-gradient(160deg, #faf7ff 0%, #f5eefc 45%, #fcf1f6 100%);
  border: 1px solid rgba(124,58,237,0.08);
  border-radius: 24px;
  box-shadow: 0 20px 48px rgba(76,29,149,0.10);
}
.line-contactus-msg__badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: #ece7fc;
  color: #6d4bd6;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.line-contactus-msg__subtitle {
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.6;
  color: #6b7280;
}
.line-contactus-msg__form {
  margin-top: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
.line-contactus-msg__field {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 14px 16px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
}
.line-contactus-msg__field-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #9ca3af;
}
.line-contactus-msg__field-icon svg { width: 18px; height: 18px; }
.line-contactus-msg__input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--ink);
}
.line-contactus-msg__input::placeholder { color: #9ca3af; }
.line-contactus-msg__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  padding: 14px var(--space-6);
  border-radius: 14px;
  background: linear-gradient(90deg, #1e2158 0%, #6d28d9 100%);
  color: #ffffff;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  box-shadow: 0 12px 28px rgba(76,29,149,0.28);
  transition: transform var(--duration-fast), box-shadow var(--duration-fast);
}
.line-contactus-msg__button:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 34px rgba(76,29,149,0.36);
}
.line-contactus-msg__button svg { width: 16px; height: 16px; }
.line-contactus-msg__success {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  color: #6d28d9;
}
.line-contactus-msg__privacy {
  margin-top: var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 12px;
  line-height: 1.5;
  color: #9ca3af;
}
.line-contactus-msg__privacy-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f3f4f6;
  color: #9ca3af;
}
.line-contactus-msg__privacy-icon svg { width: 13px; height: 13px; }
@media (max-width: 640px) {
  .line-contactus-msg__card { padding: var(--space-8) var(--space-6); }
}

/* ── CTA de cierre ── */
.line-contactus-cta {
  margin-inline: auto;
  max-width: 1560px;
  padding-inline: var(--container-pad);
  padding-block: var(--space-6) var(--space-8);
}
.line-contactus-cta__card {
  position: relative;
  aspect-ratio: 4896 / 832;
  border-radius: 28px;
  overflow: hidden;
  display: flex;
  align-items: center;
  isolation: isolate;
}
.line-contactus-cta__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.line-contactus-cta__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.line-contactus-cta__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  width: 100%;
  padding: var(--space-6) var(--space-8);
}
.line-contactus-cta__text { max-width: 480px; }
.line-contactus-cta__badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: #ece7fc;
  color: #6d4bd6;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  width: fit-content;
}
.line-contactus-cta__title {
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-weight: 800;
  font-size: clamp(var(--text-xl), 1.8vw, var(--text-2xl));
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: #111827;
}
.line-contactus-cta__subtitle {
  margin-top: var(--space-1);
  font-family: var(--font-body);
  font-size: var(--text-sm);
  line-height: 1.5;
  color: #6b7280;
}
.line-contactus-cta__button {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
  padding: var(--space-2) var(--space-4);
  border: 1.5px solid #6d4bd6;
  border-radius: var(--radius-full);
  color: #6d4bd6;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  background: transparent;
  transition: background var(--duration-fast), color var(--duration-fast);
}
.line-contactus-cta__button:hover { background: #6d4bd6; color: #ffffff; }
.line-contactus-cta__button svg { width: 16px; height: 16px; }
/* ── Responsive ── */
@media (max-width: 900px) {
  .line-contactus-features {
    position: static;
    margin-top: var(--space-8);
    padding-inline: 0;
  }
  .line-contactus-features__inner { grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .line-contactus-features__card,
  .line-contactus-features__card:first-child,
  .line-contactus-features__card:last-child {
    border-radius: 20px;
    border-right: none;
  }
  .line-contactus-msg { padding-top: var(--space-10); }
}
@media (max-width: 700px) {
  .line-contactus-hero {
    min-height: 0;
    padding-bottom: var(--space-10);
    background-position: 70% center;
  }
  .line-contactus-hero__text {
    max-width: 100%;
    padding-right: var(--container-pad);
    padding-top: calc(var(--header-h) + var(--space-8));
    padding-bottom: var(--space-16);
  }
}
@media (max-width: 560px) {
  .line-contactus-features__inner { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .line-contactus-cta__card { flex-direction: column; align-items: stretch; aspect-ratio: auto; height: auto; }
  .line-contactus-cta__bg { position: relative; width: 100%; height: 160px; }
  .line-contactus-cta__content {
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
    padding-right: var(--space-6);
  }
  .line-contactus-cta__text { max-width: 100%; }
  .line-contactus-cta__subtitle { white-space: normal; }
}
{% endstylesheet %}

{%- if section.settings.hero_image != blank -%}
  {%- assign contactus_hero_bg = section.settings.hero_image | image_url: width: 1920 -%}
{%- else -%}
  {%- assign contactus_hero_bg = section.settings.hero_image_fallback | default: 'ContactoUs.png' | asset_url -%}
{%- endif -%}

<section class="line-contactus-hero" id="line-contactus-hero-{{ section.id }}" style="background-image: url('{{ contactus_hero_bg }}');">
    <div class="line-contactus-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="line-contactus-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="line-contactus-hero__title">
        {{ section.settings.title_prefix }}
        {%- if section.settings.title_highlight != blank -%}
          <span class="line-contactus-hero__title-highlight">{{ section.settings.title_highlight }}</span>
        {%- endif -%}
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="line-contactus-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.last_updated != blank -%}
        <p class="line-contactus-hero__updated">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span>{{ section.settings.last_updated }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="line-contactus-features" id="line-contactus-features-{{ section.id }}">
      <div class="line-contactus-features__inner">
        {%- assign feature_blocks = section.blocks | where: 'type', 'feature_card' -%}
        {%- for block in feature_blocks -%}
          <div class="line-contactus-features__card" {{ block.shopify_attributes }}>
            <span class="line-contactus-features__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'headset' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12a9 9 0 0 1 18 0"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                  </svg>
                {%- when 'package' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>
                  </svg>
                {%- when 'refresh' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>
                  </svg>
                {%- when 'message' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
                  </svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="line-contactus-features__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="line-contactus-features__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
</section>

<section class="line-contactus-msg" id="line-contactus-msg-{{ section.id }}">
  <div class="line-contactus-msg__card">
    {%- if section.settings.msg_badge != blank -%}
      <span class="line-contactus-msg__badge">{{ section.settings.msg_badge }}</span>
    {%- endif -%}
    {%- if section.settings.msg_subtitle != blank -%}
      <p class="line-contactus-msg__subtitle">{{ section.settings.msg_subtitle }}</p>
    {%- endif -%}

    {%- form 'contact', class: 'line-contactus-msg__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="line-contactus-msg__success">{{ section.settings.msg_success }}</p>
      {%- endif -%}
      <div class="line-contactus-msg__field">
        <span class="line-contactus-msg__field-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/>
          </svg>
        </span>
        <input
          type="text"
          name="contact[body]"
          id="ContactOrderNumber-{{ section.id }}"
          class="line-contactus-msg__input"
          placeholder="{{ section.settings.msg_field_placeholder }}"
        >
      </div>
      <button type="submit" class="line-contactus-msg__button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
        </svg>
        <span>{{ section.settings.msg_button_label }}</span>
      </button>
    {%- endform -%}

    {%- if section.settings.msg_privacy != blank -%}
      <p class="line-contactus-msg__privacy">
        <span class="line-contactus-msg__privacy-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <span>{{ section.settings.msg_privacy }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

<div class="line-contactus-cta">
  <div class="line-contactus-cta__card">
    <div class="line-contactus-cta__bg">
      <img
        src="{{ section.settings.contact_bg_fallback | default: 'FaqContact.png' | asset_url }}"
        alt="{{ section.settings.contact_title }}"
        loading="lazy"
        width="4896"
        height="832"
      >
    </div>
    <div class="line-contactus-cta__content">
      <div class="line-contactus-cta__text">
        {%- if section.settings.contact_badge != blank -%}
          <span class="line-contactus-cta__badge">{{ section.settings.contact_badge }}</span>
        {%- endif -%}
        {%- if section.settings.contact_title != blank -%}
          <h2 class="line-contactus-cta__title">{{ section.settings.contact_title }}</h2>
        {%- endif -%}
        {%- if section.settings.contact_subtitle != blank -%}
          <p class="line-contactus-cta__subtitle">{{ section.settings.contact_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.contact_button_label != blank -%}
          <a href="{{ section.settings.contact_button_url | default: '/pages/faq' }}" class="line-contactus-cta__button">
            <span>{{ section.settings.contact_button_label }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Us",
  "tag": "section",
  "class": "section-contact-us",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "We're here to help",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "default": "Contact Us",
      "label": "Title — text"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title — highlighted word"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "default": "For any inquiries, technical assistance, or general information, our team is at your complete disposal to provide you with the support you need.",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated text"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_fallback",
      "default": "ContactoUs.png",
      "label": "Hero image fallback (file in assets/)"
    },
    {
      "type": "header",
      "content": "Send message form"
    },
    {
      "type": "text",
      "id": "msg_badge",
      "default": "Send us a message",
      "label": "Badge"
    },
    {
      "type": "textarea",
      "id": "msg_subtitle",
      "default": "Fill out the form and we'll get back to you as soon as possible.",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "msg_field_placeholder",
      "default": "Order number (optional)",
      "label": "Field placeholder"
    },
    {
      "type": "text",
      "id": "msg_button_label",
      "default": "Send message",
      "label": "Button text"
    },
    {
      "type": "text",
      "id": "msg_success",
      "default": "Thank you! We'll be in touch shortly.",
      "label": "Success message"
    },
    {
      "type": "textarea",
      "id": "msg_privacy",
      "default": "We respect your privacy. Your details will only be used to respond to your inquiry.",
      "label": "Privacy note"
    },
    {
      "type": "header",
      "content": "Table of contents"
    },
